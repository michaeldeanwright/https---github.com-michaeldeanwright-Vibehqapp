rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(conversationId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // ---------- users: readable member directory; only owner can write ----------
    // Firebase Auth does not expose an "all users" client API. VibeHQ stores
    // the public member record in Firestore so the signed-in app can display
    // everyone who has registered.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    // ---------- profiles: everyone signed in can read, only you can edit yours ----------
    match /profiles/{profileId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // ---------- posts ----------
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.created_by_id == request.auth.uid;
      // Authors can edit/delete their own posts. Anyone signed in may like or
      // comment, which only touches these fields on somebody else's post.
      allow update: if signedIn() && (
        resource.data.created_by_id == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['liked_by', 'comment_count', 'updated_date'])
      );
      allow delete: if signedIn() && resource.data.created_by_id == request.auth.uid;
    }

    // ---------- comments ----------
    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.created_by_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.created_by_id == request.auth.uid;
    }

    // ---------- conversations: only the people in them ----------
    match /conversations/{conversationId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      // On create there is no existing document, so check the incoming data.
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
    }

    // ---------- messages: only participants of that conversation ----------
    match /messages/{messageId} {
      allow read: if isParticipant(resource.data.conversation_id);
      allow create: if signedIn()
        && request.resource.data.author_id == request.auth.uid
        && isParticipant(request.resource.data.conversation_id);
      allow update, delete: if signedIn() && resource.data.author_id == request.auth.uid;
    }

    // ---------- public app settings ----------
    match /app/public {
      allow read: if true;
    }
  }
}
